    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\FlowForge.Net\FlowForge.Net.csproj" />
      <ProjectReference Include="..\Sample.ServiceDefaults\Sample.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Npgsql" />
